# ============================================================
# Emissor Fiscal SaaS — Variáveis de Ambiente
# NUNCA commitar o arquivo .env — apenas o .env.example
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://fiscal:fiscal_dev_password@localhost:5432/fiscal_platform"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
PORT=3000
NODE_ENV=development

# --- Certificado Digital A1 ---
# Encode do .pfx em base64: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cert.pfx"))
CERT_PFX_BASE64=""
CERT_PASSWORD=""

# --- SEFAZ ---
SEFAZ_UF=SP
SEFAZ_ENVIRONMENT=homologacao
# Endpoints SEFAZ SP Homologação
SEFAZ_NFE_URL=https://homologacao.nfe.fazenda.sp.gov.br/ws/nfeautorizacao4.asmx
SEFAZ_NFE_STATUS_URL=https://homologacao.nfe.fazenda.sp.gov.br/ws/nfestatusservico4.asmx
SEFAZ_NFE_CONSULTA_URL=https://homologacao.nfe.fazenda.sp.gov.br/ws/nfeconsultaprotocolo4.asmx

# --- Storage (MinIO local / S3 prod) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=fiscal_minio
STORAGE_SECRET_KEY=fiscal_minio_dev_password
STORAGE_BUCKET=fiscal-documents
STORAGE_REGION=us-east-1

# --- Azure AI Foundry (P3 — preencher depois) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
